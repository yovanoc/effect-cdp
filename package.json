{
  "name": "effect-cdp",
  "version": "0.2.0",
  "keywords": [
    "cdp",
    "chrome devtools protocol",
    "effect"
  ],
  "license": "MIT",
  "author": "yovanoc <yovano_c@outlook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yovanoc/effect-cdp.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json",
    "./generated/*": {
      "types": "./dist/generated/*.d.mts",
      "import": "./dist/generated/*.mjs"
    },
    "./helpers/*": {
      "types": "./dist/helpers/*.d.mts",
      "import": "./dist/helpers/*.mjs"
    },
    "./layers/*": {
      "types": "./dist/layers/*.d.mts",
      "import": "./dist/layers/*.mjs"
    }
  },
  "scripts": {
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "codegen": "bun scripts/codegen.ts",
    "check-codegen": "bun scripts/check-codegen.ts",
    "build": "tsdown",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:integration": "bun test tests/integration.test.ts",
    "smoke": "bun scripts/smoke.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "ts:check": "tsc --noEmit",
    "check": "bun run --parallel fmt:check lint ts:check test",
    "prepublishOnly": "bun run build",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/tsgo": "0.37.0",
    "@effect/vitest": "4.0.0-rc.112",
    "@types/bun": "1.4.0",
    "devtools-protocol": "0.0.1686980",
    "effect": "4.0.0-rc.112",
    "lint-staged": "17.3.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "testcontainers": "12.1.0",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "ws": "8.21.3"
  },
  "peerDependencies": {
    "@effect/platform-bun": ">=4.0.0-rc.112 || >=4.0.0",
    "@effect/platform-node": ">=4.0.0-rc.112 || >=4.0.0",
    "effect": ">=4.0.0-rc.112 || >=4.0.0"
  },
  "peerDependenciesMeta": {
    "@effect/platform-bun": {
      "optional": true
    },
    "@effect/platform-node": {
      "optional": true
    }
  },
  "lint-staged": {
    "*": "bun run oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "bun run lint"
  },
  "engines": {
    "bun": ">=1.1",
    "node": ">=26"
  }
}
